# ============================================================
#  Cube —— 环境变量
#  复制为 .env.local 后填写（.env.local 已被 gitignore）
# ============================================================

# ---------- 服务 ----------
PORT=4500

# ---------- 数据库（MySQL）----------
# 库不存在时会自动创建（utf8mb4），表也会自动建
# 格式：mysql://用户名:密码@主机:端口/库名
DATABASE_URL=mysql://root:password@127.0.0.1:3306/ai_video

# ---------- 剧本生成 LLM（任意 OpenAI 兼容接口）----------
# DeepSeek:   https://api.deepseek.com/v1       模型 deepseek-chat
# Kimi:       https://api.moonshot.cn/v1        模型 kimi-k2-0905-preview
# 智谱:       https://open.bigmodel.cn/api/paas/v4   模型 glm-4.6
# 豆包方舟:   https://ark.cn-beijing.volces.com/api/v3  模型 doubao-seed-1-6-250615
# OpenAI:     https://api.openai.com/v1         模型 gpt-4.1-mini
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_MS=180000

# 单次调用的输出预算（思考型模型的 reasoning tokens 也算在里面）
LLM_MAX_TOKENS=6000
# 是否开启思考模式：本项目只要 JSON，思考会把预算吃光导致正文为空，默认关
LLM_THINKING=false

# ---------- 视频生成：阿里云百炼（多模型可选）----------
# 每个剧本创建时自己选模型，可选值与单镜时长区间见 lib/video-models.ts：
#   happyhorse-1.1  3~15 秒，首帧 / 参考图生视频，原生音视频联合生成（音轨不可关）
#   wan3.0-video    2~30 秒，首尾帧 / 参考视频音频，音轨可开关
# 两个模型共用同一套 Key 与异步接口地址
# 百炼 DashScope API Key（sk- 开头）
VIDEO_API_KEY=

# 原生异步接口 base（注意不要用 /compatible-mode/v1）
VIDEO_BASE_URL=https://cn-beijing.maas.qianwenaiapi.com/api/v1

# HappyHorse 1.1：三种生成模式是三个独立模型 ID，默认由基础名派生
VIDEO_MODEL_HAPPYHORSE=happyhorse-1.1
# 需要单独换某个模式的模型时才填，留空即按基础名派生
# VIDEO_MODEL_T2V=happyhorse-1.1-t2v
# VIDEO_MODEL_I2V=happyhorse-1.1-i2v
# VIDEO_MODEL_R2V=happyhorse-1.1-r2v

# 万相 wan3.0：单模型，文生 / 首尾帧 / 参考素材都走它
VIDEO_MODEL_WAN=wan3.0-video

# 画质 / 画幅现在按项目设置（创建项目时选择，默认 480p / 16:9）。
# 下面两项只是兜底：项目没有设置、或老客户端没传时才会用到。
# 输出分辨率：480p / 720p / 1080p（请求时自动转成 480P / 720P / 1080P）
VIDEO_RESOLUTION=480p

# 画面比例：21:9 / 16:9 / 4:3 / 3:4 / 4:5 / 5:4 / 1:1 / 9:21 / 9:16
# HappyHorse 首帧模式的画幅跟随首帧；wan3.0 带首尾帧时固定 adaptive
VIDEO_RATIO=16:9

# 兜底时长（秒），实际以每个镜头的 duration 为准（会被模型区间夹住）
VIDEO_DURATION=5

# HappyHorse 右下角「Happy Horse」水印，默认关（wan3.0 没有这个开关）
VIDEO_WATERMARK=false

# 仅 wan3.0 生效：音轨开关（true=原生出声）与提示词智能扩写
# HappyHorse 1.1 的音轨始终生成、没有开关，这两项对它无效
VIDEO_AUDIO=true
VIDEO_PROMPT_EXTEND=false

# ---------- 角色卡 / 场景卡配图（万相文生图）----------
# 留空则复用上面的 VIDEO_API_KEY 与 VIDEO_BASE_URL
IMAGE_API_KEY=
IMAGE_BASE_URL=
# wan2.6-t2i 走同步协议；wan2.5 及以下会自动切换成异步轮询
IMAGE_MODEL=wan2.6-t2i

# ---------- 成片合成（可选）----------
# 把多个镜头视频拼接成一个 MP4 需要 ffmpeg：macOS 执行 brew install ffmpeg
# 默认从 PATH 查找，装在非标准位置时在这里指定可执行文件绝对路径
FFMPEG_PATH=

# ---------- 站点 ----------
# 对外可访问地址，如 https://cube.example.com
# 用于把本地上传的素材（/api/uploads/...）拼成绝对地址交给视频模型
# 留空则用请求来源，通常就是 localhost —— 云端视频模型访问不到本机素材
PUBLIC_BASE_URL=

# ---------- 任务轮询 ----------
# 前端轮询视频任务状态的间隔（毫秒）
NEXT_PUBLIC_POLL_INTERVAL_MS=5000
